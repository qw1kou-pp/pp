# RepoGuard local configuration
# Copy this file to .env before running the project:
#   cp .env.example .env

PROJECT_NAME="RepoGuard"
STACK_NAME=repoguard
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173

# Change these before deploying publicly.
SECRET_KEY=change-me-generate-a-long-random-value
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# PostgreSQL used by Docker Compose.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Docker image names used by compose.yml.
DOCKER_IMAGE_BACKEND=repoguard-backend
DOCKER_IMAGE_FRONTEND=repoguard-frontend
TAG=latest

# Optional email settings. Local compose.override.yml uses mailcatcher.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com

SENTRY_DSN=

# Optional GitHub access. Public repositories work without a token,
# but a token improves rate limits.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Optional LLM and embedding providers.
# RAG/Agent answer generation and embedding features need these values.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=

# Repository analysis worker settings.
REPOSITORY_ANALYSIS_MAX_ATTEMPTS=3
REPOSITORY_ANALYSIS_HEARTBEAT_INTERVAL_SECONDS=30
REPOSITORY_ANALYSIS_LEASE_SECONDS=90
REPOSITORY_ANALYSIS_RECOVERY_INTERVAL_SECONDS=60
REPOSITORY_ANALYSIS_RECOVERY_BATCH_SIZE=100
REPOSITORY_SNAPSHOT_CLEANUP_INTERVAL_SECONDS=3600
REPOSITORY_SNAPSHOT_CLEANUP_BATCH_SIZE=100
REPOSITORY_SNAPSHOT_FAILED_RETENTION_HOURS=0
REPOSITORY_SNAPSHOT_SAVED_RETENTION_HOURS=168
REPOSITORY_SNAPSHOT_ORPHAN_GRACE_HOURS=6

# Optional live recovery acceptance settings.
RUN_REPOSITORY_RECOVERY_ACCEPTANCE_LIVE=0
REPOSITORY_RECOVERY_ACCEPTANCE_REPOSITORY_URL=https://github.com/psf/requests
REPOSITORY_RECOVERY_ACCEPTANCE_OUTPUT_DIR=artifacts/repository-recovery-acceptance
REPOSITORY_RECOVERY_ACCEPTANCE_TIMEOUT_SECONDS=1800
REPOSITORY_RECOVERY_FAULT_WORKER_TIMEOUT_SECONDS=600
REPOSITORY_RECOVERY_EXPECTED_MAX_ATTEMPTS_ERROR_CODE=worker_lease_expired
REPOSITORY_RECOVERY_COMPOSE_FILES=compose.yml,docker-compose.repository-recovery.yml
REPOSITORY_RECOVERY_PROJECT_DIRECTORY=.
